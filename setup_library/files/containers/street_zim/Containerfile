# Reader using the same Library base image as the other appliance services.
ARG BASE_IMAGE=localhost/rasbase_master:latest
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates kiwix-tools nginx python3 python3-serial \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/street_zim
COPY server.py nginx.conf.in ./
COPY gps/ ./gps/
COPY static/ ./static/
RUN mkdir -p /data /tmp/street_zim
ENV PYTHONUNBUFFERED=1 GPS_MODE=relay GPS_UPSTREAM=http://10.88.0.212:8080
EXPOSE 8093
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8093/health', timeout=3)"
ENTRYPOINT ["python3", "/opt/street_zim/server.py"]
