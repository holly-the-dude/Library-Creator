ARG BASE_IMAGE=localhost/rasbase_master:latest
FROM ${BASE_IMAGE}

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY server.py music.html ./
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MUSIC_DIR=/music HOST=0.0.0.0 PORT=8080
USER 1000:1000
EXPOSE 8080
CMD ["python3", "server.py"]
