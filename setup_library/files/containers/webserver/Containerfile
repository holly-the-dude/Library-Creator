# Containerfile for the Library webserver container
# This container runs nginx + a Python management script (library.py)
# that monitors and controls other library service containers.

# Base image - switch between rasbase (Debian 11 bullseye) and
# rasbase_master (Debian 13 trixie) by passing --build-arg BASE_IMAGE=...
ARG BASE_IMAGE=localhost/rasbase_master:latest
FROM ${BASE_IMAGE}

# Install system packages:
#   nginx-full       - web server for serving library content
#   python3          - runtime for library.py management script
#   fcgiwrap         - FastCGI wrapper for CGI scripts (shutdown endpoint)
#   python3-requests - HTTP library for checking service health
#   python3-yaml     - YAML parser for reading library_setup.yml config
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nginx-full \
        python3 \
        fcgiwrap \
        python3-requests \
        python3-yaml && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy the main management script
COPY library.py /root/library.py

# Copy the configuration file that defines containers and services
COPY library_setup.yml /root/library_setup.yml

# Copy CGI scripts (shutdown.py provides remote shutdown via port 9999)
COPY cgi/ /root/cgi/

# Expose nginx web server port and shutdown CGI port
EXPOSE 80 9999

# Start library.py (configures nginx, monitors services) then keep container alive
CMD ["/bin/sh", "-c", "/usr/bin/python3 /root/library.py;sleep infinity"]
