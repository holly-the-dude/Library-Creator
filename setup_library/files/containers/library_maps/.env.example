# library_maps stack configuration (used by compose.yaml)

# Web UI port
MAP_PORT=8080

# GPS settings (optional). Empty port auto-detects an unambiguous USB receiver.
# Use compose.gps.yaml on Linux for USB discovery and hotplug.
# If several serial devices are present, select /dev/serial/by-id/<receiver>;
# that persistent name is preferred to a ttyUSB/ttyACM number that can change.
GPS_PORT=
# Match the receiver's configured NMEA baud rate (9600 is the default).
GPS_BAUD=9600

# PMTiles map volume (served at /storage/maps). On the Pi this is the USB
# mounted at /Library; the maps live under /Library/maps.
MAPS_DIR=/Library/maps

# Directory containing the routing extract. get-osm.sh writes region.osm.pbf
# here. It sits under the maps volume so it rides the same USB mount.
OSM_DIR=/Library/maps/osm

# Where GraphHopper stores its built routing graph (persisted across restarts).
GRAPH_CACHE_DIR=./data/graph-cache

# GraphHopper JVM memory. 3G is reasonable for a state-sized extract.
# A full-US extract needs much more (8G+) and a lot of import time.
GH_JAVA_OPTS=-Xms512m -Xmx3g

# Base image for building both services.
BASE_IMAGE=localhost/rasbase_master:latest
