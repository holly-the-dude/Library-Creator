# library_maps - PMTiles map tile server for Raspberry Pi
# Based on rasbase_master (Debian 13 trixie arm64)
# Serves .pmtiles files via nginx with HTTP range request support
# Compatible with MapLibre GL JS clients

# Overridable base image (defaults to rasbase_master). Kept in sync with the
# graphhopper service so the whole stack builds on one base.
ARG BASE_IMAGE=localhost/rasbase_master:latest
FROM ${BASE_IMAGE}

LABEL description="PMTiles map tile server for offline maps on Raspberry Pi"

# Python reads the appliance's serial GPS; nginx exposes its status to clients.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nginx \
        curl \
        ca-certificates \
        python3 \
        python3-serial \
    && rm -rf /var/lib/apt/lists/*

# Install go-pmtiles for arm64
ARG PMTILES_VERSION=1.30.2
RUN set -eux; \
    TARBALL="go-pmtiles_${PMTILES_VERSION}_Linux_arm64.tar.gz"; \
    cd /tmp; \
    curl -fsSL -o "$TARBALL" \
      "https://github.com/protomaps/go-pmtiles/releases/download/v${PMTILES_VERSION}/${TARBALL}"; \
    tar -xzf "$TARBALL" -C /usr/local/bin pmtiles; \
    rm -f "$TARBALL"; \
    chmod +x /usr/local/bin/pmtiles; \
    /usr/local/bin/pmtiles version

# Create the map storage directory structure
RUN mkdir -p /storage/maps/pmtiles \
             /storage/maps/basemaps-assets \
             /storage/maps/styles

# Copy the web viewer (served from image, not the volume)
RUN mkdir -p /var/www/html/vendor
COPY index.html /var/www/html/index.html
# Serve the GPS controls locally so hotspot clients need no external libraries.
COPY gps-control.js gps-control.css /var/www/html/
# Keep the service beside its parser for Python imports, outside the web root.
COPY read_gps.py gps_service.py /usr/local/lib/library_maps/
# Vendored map libraries so the client needs no internet/CDN access.
# Clients on the offline hotspot network cannot reach unpkg.com, so these
# must be served locally. See vendor/ for the pinned library versions.
COPY vendor/ /var/www/html/vendor/

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Only nginx is public; the GPS API stays on loopback and uses nginx's /api/gps.
EXPOSE 8080

# A missing receiver or satellite fix is normal and must not fail map health.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
