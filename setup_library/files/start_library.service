[Unit]
Description=Library Display Data
After=fbi.service

[Service]
# The playbook launches detached containers, then exits successfully. Keep the
# unit active so systemd does not tear down their conmon log-monitor processes.
Type=oneshot
RemainAfterExit=yes
# USB insertion, content imports and initial setup can take an arbitrary time.
TimeoutStartSec=0
ExecStart=/root/.local/bin/ansible-playbook /root/start_library.yml
[Install]
WantedBy=multi-user.target
